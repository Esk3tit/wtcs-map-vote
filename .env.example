# WTCS Map Vote - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# CONVEX
# =============================================================================
# Your Convex deployment URL (from Convex dashboard)
# Format: https://<deployment-name>.convex.cloud
VITE_CONVEX_URL=

# Convex deployment name (used for CLI commands)
# Format: <team>:<project>
CONVEX_DEPLOYMENT=

# =============================================================================
# GOOGLE OAUTH (Admin Authentication)
# =============================================================================
# Google OAuth 2.0 credentials from Google Cloud Console
# See: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# APPLICATION
# =============================================================================
# Base URL for the application (used for generating player access links)
# Example: https://wtcsmapban.com or http://localhost:5173 for development
VITE_APP_URL=http://localhost:5173

# =============================================================================
# SENTRY
# =============================================================================
VITE_SENTRY_DSN=

# =============================================================================
# POSTHOG ANALYTICS (optional — disabled when empty)
# =============================================================================
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_KEY=
